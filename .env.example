# Copy to .env and fill in the keys for the providers you use.
# Keys stay on the local server and are never sent to the browser.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web search. With search mode "auto" (Settings -> Web search), Tavily is used if its key
# is set, else Brave, else the model provider's own built-in search.
#   Tavily: results are summarized passages, so models can often answer without opening pages.
#   Brave: ordinary web results; cheaper and more neutral, but models open more pages.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: key for a custom OpenAI-compatible endpoint (base URL is set on the Settings page)
CUSTOM_API_KEY=

# Optional: API server port (default 8787)
# PORT=8787

# Optional: SQLite database file (default ./data/switchbox.db)
# DATABASE_FILE=./data/switchbox.db

# Optional: folder holding each chat's workspace files (default ./data/workspaces)
# WORKSPACE_DIR=./data/workspaces

# Optional: server logs. LOG_LEVEL is debug, info (default), warn or error.
# LOG_FORMAT=json writes one JSON object per line instead of text.
# LOG_LEVEL=info
# LOG_FORMAT=text
