# Copy to .env and fill in the keys for the providers you use.
# Keys stay on the local server and are never sent to the browser.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: key for a custom OpenAI-compatible endpoint (base URL is set on the Settings page)
CUSTOM_API_KEY=

# Optional: API server port (default 8787)
# PORT=8787

# Optional: SQLite database file (default ./data/switchbox.db)
# DATABASE_FILE=./data/switchbox.db
